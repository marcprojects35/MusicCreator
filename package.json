{
  "name": "music-creator",
  "version": "1.0.0",
  "description": "Professional DAW - Music Creator",
  "main": "electron/main/index.js",
  "scripts": {
    "start": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite --port 3000",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "build": "vite build && electron-builder",
    "backend": "cd backend && uvicorn app.main:app --reload --port 8000"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.11.0",
    "redux": "^4.2.1",
    "@reduxjs/toolkit": "^1.9.5",
    "react-redux": "^8.0.7",
    "tone": "^14.7.77",
    "wavesurfer.js": "^7.3.2",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "axios": "^1.4.0",
    "socket.io-client": "^4.6.1",
    "electron-store": "^8.1.0",
    "uuid": "^9.0.0",
    "tailwindcss": "^3.3.2",
    "@headlessui/react": "^1.7.15",
    "framer-motion": "^10.12.4",
    "recharts": "^2.7.2",
    "zustand": "^4.3.8"
  },
  "devDependencies": {
    "electron": "^25.1.0",
    "electron-builder": "^24.4.0",
    "vite": "^4.3.9",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.0",
    "wait-on": "^7.0.1",
    "typescript": "^5.1.3"
  },
  "build": {
    "appId": "com.musiccreator.app",
    "productName": "Music Creator",
    "directories": { "output": "dist" },
    "files": ["dist/**/*", "electron/**/*", "samples/**/*"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
